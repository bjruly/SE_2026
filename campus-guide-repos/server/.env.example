# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG đưa file .env lên GitHub.

# Chuỗi kết nối PostgreSQL (lấy từ trang Neon của bạn, mục Connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Chuỗi bí mật để ký token đăng nhập (ít nhất 32 ký tự ngẫu nhiên)
JWT_SECRET=doi-thanh-mot-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Các địa chỉ web được phép gọi API từ trình duyệt, cách nhau bằng dấu phẩy.
# Để trống = cho phép tất cả (chỉ nên để trống khi phát triển).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Cổng chạy khi phát triển trên máy
PORT=4000

# Dùng cho lệnh "npm run admin:create" (tạo tài khoản Quản trị đầu tiên)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-nay-it-nhat-8-ky-tu
ADMIN_NAME=Quản trị viên
