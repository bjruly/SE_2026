{
  "name": "campus-guide-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API (Express + PostgreSQL) cho dự án thuyết minh tự động đa ngôn ngữ",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:schema": "node scripts/run-sql.js sql/schema.sql",
    "db:seed": "node scripts/run-sql.js sql/seed.sql",
    "admin:create": "node scripts/create-admin.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11"
  }
}
