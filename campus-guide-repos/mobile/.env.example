# Sao chép thành .env rồi chỉnh. File .env không được đưa lên GitHub.
# Sau khi sửa .env, hãy khởi động lại Expo bằng:  npx expo start -c

# Địa chỉ backend. Điện thoại thật không dùng được localhost, hãy dùng IP máy tính trong mạng hoặc địa chỉ đã triển khai.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Nguồn bản đồ: openfreemap (mặc định) hoặc osm
EXPO_PUBLIC_MAP_PROVIDER=openfreemap
# EXPO_PUBLIC_MAP_STYLE_URL=
