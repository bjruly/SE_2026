# Sao chép thành .env.local rồi chỉnh cho đúng. File .env.local không được đưa lên GitHub.

# Địa chỉ backend (thư mục server). Khi chạy trên máy: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Địa chỉ web của người dùng (thư mục web). Dùng để tạo mã QR dạng liên kết, quét bằng camera điện thoại là mở thẳng địa điểm.
# Để trống thì dashboard chỉ tạo mã QR dạng mã (dùng cho chức năng "Quét QR" trong app).
NEXT_PUBLIC_WEB_URL=https://se-2026-psi.vercel.app
