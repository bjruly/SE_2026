# Sao chép thành .env.local rồi chỉnh. File .env.local không được đưa lên GitHub.
# (Trên Vercel: đặt các biến này trong Settings > Environment Variables rồi triển khai lại.)

# Địa chỉ backend (thư mục server). Để trống = dùng file data/pois.json, không ghi thống kê.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Nguồn bản đồ: openfreemap (mặc định, không cần khóa) hoặc osm (ô ảnh OpenStreetMap chuẩn)
NEXT_PUBLIC_MAP_PROVIDER=openfreemap

# (Tùy chọn) Đường dẫn style MapLibre tự chọn, ví dụ của nhà cung cấp có khóa API. Nếu đặt thì ưu tiên hơn MAP_PROVIDER.
# NEXT_PUBLIC_MAP_STYLE_URL=
